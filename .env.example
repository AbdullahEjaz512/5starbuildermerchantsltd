# Resend API integration for the contact form.
# Copy this file to .env and fill in real values. NEVER commit .env.

# Required: Your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: The verified sending email address.
# Must use a domain you have verified in your Resend dashboard.
CONTACT_FROM_EMAIL=info@5starbuildersmerchants.co.uk

# Required: The business inbox that will receive enquiries.
CONTACT_TO_EMAIL=info@5starbuildersmerchants.co.uk

# Optional: Customise the email subject line (default: "New Website Enquiry — 5 Star Builders Merchants")
# CONTACT_SUBJECT=New Website Enquiry — 5 Star Builders Merchants

# Rate limiting notes
# The in-memory rate limiter works per server instance. On serverless platforms
# (Vercel), each function invocation may use a fresh instance, so this is a
# first line of defence only. For production-grade limiting across instances,
# integrate a persistent store such as Upstash Redis:
#   https://resend.com/docs/faq#rate-limiting
#   https://upstash.com/docs/oss/redis/sdks/nextjs-rate-limiter